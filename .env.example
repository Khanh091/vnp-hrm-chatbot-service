APP_NAME=VNPT HRM Chatbot Service
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

ODOO_BASE_URL=http://localhost:8069
# FastAPI container -> Odoo running on the host machine.
ODOO_DOCKER_BASE_URL=http://host.docker.internal:8069
ODOO_DATABASE=hrm
ODOO_INTERNAL_API_KEY=change-me
ODOO_CONNECT_TIMEOUT_SECONDS=5
ODOO_READ_TIMEOUT_SECONDS=30

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=30m
TOOL_EMBEDDING_DIMENSION=768

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=change-me
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_CLASSIFIER_MODEL=qwen/qwen3.6-27b
GROQ_SELECTOR_MODEL=qwen/qwen3.6-27b
GROQ_RESPONSE_MODEL=openai/gpt-oss-20b
GROQ_FINAL_ANSWER_MODEL=qwen/qwen3.6-27b
FINAL_ANSWER_TEMPERATURE=0.1
FINAL_ANSWER_MAX_TOKENS=300
MAX_FINAL_ANSWER_ITEMS=20
MAX_FINAL_ANSWER_CONTEXT_CHARS=12000
GROQ_TIMEOUT_SECONDS=60
GROQ_REASONING_EFFORT=none
GROQ_TEMPERATURE=0.1
LLM_MAX_RETRIES=1
LLM_MAX_RETRY_AFTER_SECONDS=3
LLM_STRUCTURED_REPAIR_ATTEMPTS=1

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5434/hrm_chatbot

# Docker Compose PostgreSQL settings.
CHATBOT_POSTGRES_DB=hrm_chatbot
CHATBOT_POSTGRES_USER=hrm_chatbot
CHATBOT_POSTGRES_PASSWORD=change-me
CHATBOT_POSTGRES_PORT=5434
OLLAMA_PORT=11434
# Reuse the volume created by a manually-run Ollama container when applicable.
OLLAMA_VOLUME_NAME=ollama

TOOL_TOP_K=5
TOOL_FETCH_K=20
TOOL_MIN_SCORE=0.45
TOOL_SELECTION_MIN_CONFIDENCE=0.80
SENSITIVE_TOOL_SELECTION_MIN_CONFIDENCE=0.85
WRITE_TOOL_SELECTION_MIN_CONFIDENCE=0.90
TOOL_MIN_MARGIN=0.05
PENDING_ACTION_TTL_SECONDS=900
PENDING_EXECUTION_LEASE_SECONDS=30
CONVERSATION_STATE_TTL_SECONDS=86400
MAX_WORKFLOW_STEPS_PER_REQUEST=20
MAX_TOOL_CALLS_PER_REQUEST=1
TOOL_SELECTOR_MAX_CANDIDATES=3
TOOL_SELECTOR_EXAMPLES_PER_KIND=2

# Dedicated Odoo web proxy -> FastAPI key. Never reuse ODOO_INTERNAL_API_KEY.
CHATBOT_INGRESS_API_KEY=change-me
