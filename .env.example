APP_NAME=VNPT HRM Chatbot Service
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

ODOO_BASE_URL=http://localhost:8069
ODOO_DATABASE=hrm_ai
ODOO_INTERNAL_API_KEY=change-me
ODOO_CONNECT_TIMEOUT_SECONDS=5
ODOO_READ_TIMEOUT_SECONDS=30

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=30m
TOOL_EMBEDDING_DIMENSION=768

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=change-me
GROQ_CHAT_MODEL=qwen/qwen3.6-27b
GROQ_TIMEOUT_SECONDS=60

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5434/hrm_chatbot

TOOL_TOP_K=5
TOOL_FETCH_K=20
TOOL_MIN_SCORE=0.45
TOOL_SELECTION_MIN_CONFIDENCE=0.80
SENSITIVE_TOOL_SELECTION_MIN_CONFIDENCE=0.85
WRITE_TOOL_SELECTION_MIN_CONFIDENCE=0.90
TOOL_MIN_MARGIN=0.05
PENDING_ACTION_TTL_SECONDS=900
PENDING_EXECUTION_LEASE_SECONDS=30
CONVERSATION_STATE_TTL_SECONDS=86400
MAX_WORKFLOW_STEPS_PER_REQUEST=20
MAX_TOOL_CALLS_PER_REQUEST=1
TOOL_SELECTOR_MAX_CANDIDATES=3
TOOL_SELECTOR_EXAMPLES_PER_KIND=2

# Dedicated Odoo web proxy -> FastAPI key. Never reuse ODOO_INTERNAL_API_KEY.
CHATBOT_INGRESS_API_KEY=change-me
